{
  "name": "@coral/react",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./accordion": {
      "types": "./dist/accordion.d.ts",
      "import": "./dist/accordion.js"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "import": "./dist/field.js"
    },
    "./use-render": {
      "types": "./dist/use-render.d.ts",
      "import": "./dist/use-render.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@terra/typescript-config": "workspace:*",
    "@terra/vitest-config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "axe-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
